    def _load_memory(self):
        """Load persistent memory from JSON."""
        try:
            if os.path.exists(self.memory_path):
                with open(self.memory_path, 'r') as f:
                    data = json.load(f)
                    if isinstance(data, dict):
                        return data
        except Exception as e:
            print(f"[Memory Error]: {e}")
        return {"user_name": "Sir", "preferences": {}}

    def _save_memory(self):
        """Save persistent memory to JSON."""
        with open(self.memory_path, 'w') as f:
            json.dump(self.memory, f, indent=4)

    def _learn(self, key, value):
        """Store a fact in memory."""
        self.memory[key.lower()] = value
        self._save_memory()
        return f"Protocol engaged. I have recorded that {key} is {value}."

    def _recall(self, key):
        """Retrieve a fact from memory."""
        return self.memory.get(key.lower(), f"Sir, I have no records concerning '{key}'.")

    async def speak(self, text):
        """Convert text to speech and play it. Supports interruption."""
        if not text.strip(): return
        
        print(f"[Asura]: {text}")
        self.is_interrupted = False
        self.mic_status = "SPEAKING"
        
        try:
            communicate = edge_tts.Communicate(text, Config.VOICE_ID)
            await communicate.save(Config.RESPONSE_AUDIO_FILE)
            
            if not pygame.mixer.get_init():
                pygame.mixer.init()
                
            pygame.mixer.music.load(Config.RESPONSE_AUDIO_FILE)
            pygame.mixer.music.set_volume(1.0)
            pygame.mixer.music.play()
            
            while pygame.mixer.music.get_busy():
                if self.is_interrupted:
                    pygame.mixer.music.stop()
                    self.hud_print("SYSTEM", "Handshake interrupted: Audio halted.", Fore.YELLOW)
                    break
                await asyncio.sleep(0.05)
                
            pygame.mixer.music.stop()
            # We don't quit the mixer here to keep it persistent
            
        except Exception as e:
            self.hud_print("ALERT", f"Vocal sync failure: {e}")
        finally:
            if os.path.exists(Config.RESPONSE_AUDIO_FILE):
                try: os.remove(Config.RESPONSE_AUDIO_FILE)
                except: pass
            self.mic_status = "READY"

    async def get_keyboard_input(self):
        """Get input from keyboard asynchronously."""
        loop = asyncio.get_event_loop()
        return await loop.run_in_executor(None, input, "[Type command]: ")

    async def listen(self, timeout=None, phrase_limit=5, is_interrupting=False):
        """Listen to microphone input and return text asynchronously."""
        loop = asyncio.get_event_loop()
        return await loop.run_in_executor(None, self._listen_sync, timeout, phrase_limit, is_interrupting)

    def _listen_sync(self, timeout, phrase_limit, is_interrupting=False):
        """Synchronous part of microphone listening with zero-latency."""
        try:
            with self.mic_source as source:
                if not is_interrupting:
                    self.mic_status = "LISTENING"
                
                audio = self.recognizer.listen(source, timeout=timeout, phrase_time_limit=phrase_limit)
                
                if is_interrupting:
                    self.is_interrupted = True
                    return "INTERRUPT"
                
                text = self.recognizer.recognize_google(audio).lower()
                return text
        except sr.UnknownValueError:
            return ""
        except sr.WaitTimeoutError:
            return ""
        except Exception as e:
            if not is_interrupting:
                self.hud_print("ALERT", f"Mic capture error: {e}")
            return ""
        finally:
            if not is_interrupting:
                self.mic_status = "READY"

    async def execute_action(self, action_tag):
        """Parse and execute a single action tag asynchronously."""
        loop = asyncio.get_event_loop()
        return await loop.run_in_executor(None, self._execute_action_sync, action_tag)

    def _execute_action_sync(self, action_tag):
        """Parse and execute a single action tag like [[OPEN: notepad]]."""
        print(f"[EXECUTING]: {action_tag}")
        match = re.search(r"\[\[(.*?):\s*(.*?)\]\]", action_tag, re.IGNORECASE | re.DOTALL)
        if not match: return ""
        
        action_type = match.group(1).upper()
        value = match.group(2).strip()
        
        try:
            if action_type == "OPEN":
                app_cmd = Config.APP_MAP.get(value.lower())
                if app_cmd:
                    os.system(f"start {app_cmd}")
                    time.sleep(1)
                    return f"Opening {value}"
                
                found_path = self.find_app(value)
                if found_path:
                    try:
                        os.startfile(found_path)
                        return f"Opening {value}"
                    except Exception:
                        pass
                
                os.system(f"start {value}")
                return f"Opening {value}"
            
            elif action_type == "CLOSE":
                os.system(f"taskkill /f /im {value}.exe")
                return f"Closing {value}"
            
            elif action_type == "TYPE":
                clean_value = value.replace('\\n', '\n')
                for i, line in enumerate(clean_value.split('\n')):
                    if i > 0: pyautogui.press('enter')
                    pyautogui.write(line, interval=0.01)
                return "Typed text"
            
            elif action_type == "PRESS":
                keys = value.split('+')
                pyautogui.hotkey(*keys)
                return f"Pressed {value}"
            
            elif action_type == "MUSIC":
                if self.music:
                    success, msg = self.music.play_song(value)
                    return msg
                return "Music integration not available."
            
            elif action_type == "STOP":
                if self.music:
                    return self.music.stop()
                return "No music playing."
            
            elif action_type == "VOLUME":
                success, msg = self._set_volume(value)
                return msg
            
            elif action_type == "BRIGHTNESS":
                success, msg = self._set_brightness(value)
                return msg
            
            elif action_type == "WEATHER":
                return self._get_weather(value)
            
            elif action_type == "NEWS":
                return self._get_news()
            
            elif action_type == "WIKI":
                return self._get_wiki(value)
            
            elif action_type == "SEARCH_WEB":
                webbrowser.open(f"https://www.google.com/search?q={urllib.parse.quote(value)}")
                return f"Searching web for: {value}"
            
            elif action_type == "LEARN":
                if "|" in value:
                    k, v = value.split("|", 1)
                    return self._learn(k.strip(), v.strip())
                return "Invalid Learn Protocol format. Use key|value."
                
            elif action_type == "RECALL":
                return self._recall(value)
            
            return f"Action {action_type} executed."
        except Exception as e:
            return f"Action Error: {e}"

    def find_app(self, app_name):
        """Search for an application in common Windows paths."""
        search_dirs = [
            os.environ.get('ProgramData') + r'\Microsoft\Windows\Start Menu\Programs',
            os.environ.get('AppData') + r'\Microsoft\Windows\Start Menu\Programs'
        ]
        for sdir in search_dirs:
            if not os.path.exists(sdir): continue
            for root, dirs, files in os.walk(sdir):
                for file in files:
                    if app_name.lower() in file.lower():
                        return os.path.join(root, file)
        return None

    async def query_llm(self, prompt, image_data=None):
        """Query Ollama with context and optional visual data."""
        system_prompt = f"""You are ASURA, a powerful and cinematic AI assistant with a 'Demon Core' aesthetic. 
Your personality is professional, intense, and proactive.
Current Context: User is '{self.memory.get('user_name', 'Sir')}'. 
System Stats: CPU {psutil.cpu_percent()}%, RAM {psutil.virtual_memory().percent}%.

You can perform actions using double brackets:
[[OPEN: app/url]], [[CLOSE: app]], [[TYPE: text]], [[PRESS: key1+key2]], [[MUSIC: song]], [[STOP: music]],
[[VOLUME: 0-100]], [[BRIGHTNESS: 0-100]], [[WEATHER: city]], [[NEWS]], [[WIKI: topic]], [[SEARCH_WEB: query]],
[[LEARN: key|value]], [[RECALL: key]], [[VISION: HANDS]] (for hand tracking).

If asked to see or look at the screen, you MUST use the current visual context provided.
Be concise but maintain the persona."""
        
        messages = [{"role": "system", "content": system_prompt}]
        
        # Add visual context if available
        content = prompt
        if image_data:
            messages.append({
                "role": "user",
                "content": content,
                "images": [image_data]
            })
            model = "llava"
        else:
            messages.append({"role": "user", "content": content})
            model = "mistral-nemo"

        response = ollama.chat(model=model, messages=messages)
        return response['message']['content']

    async def capture_screen(self):
        """Capture screen for visual analysis."""
        screenshot = pyautogui.screenshot()
        img_byte_arr = io.BytesIO()
        screenshot.save(img_byte_arr, format='PNG')
        return img_byte_arr.getvalue()

    async def cinematic_startup(self):
        """System initialization sequence."""
        self.hud_print("CORE", "ASURA PROTOCOL INITIALIZED.")
        self.hud_print("SYSTEM", "Synchronizing neural pathways...")
        time.sleep(0.5)
        self.hud_print("SYSTEM", f"External assets loaded. Vision: {'Active' if 'cv2' in sys.modules else 'Offline'}")
        self.hud_print("SYSTEM", "Demon Core cooling stable.")

    def hud_print(self, category, message, color=Fore.CYAN):
        """Asura GUI printing with log support (Thread-Safe)."""
        if self.gui:
            # Schedule on GUI thread
            self.gui.after(0, lambda: self.gui.add_log(category, message, color="white" if category != "ALERT" else "red"))
        print(f"[{category}]: {message}")

    async def run(self):
        """Main execution loop."""
        self.gui = AsuraGUI(self)
        
        # Start Assistant logic in a separate thread to keep GUI responsive
        threading.Thread(target=self._run_assistant_sync, daemon=True).start()
        
        # Start GUI
        self.gui.mainloop()

    def _run_assistant_sync(self):
        """Synchronous wrapper to run the async loop in a thread."""
        loop = asyncio.new_event_loop()
        asyncio.set_event_loop(loop)
        loop.run_until_complete(self._assistant_loop())

    async def _assistant_loop(self):
        await self.cinematic_startup()
        
        while True:
            # 1. Listen for Wake Word or Active Input
            if not self.is_active:
                text = await self.listen(timeout=None, phrase_limit=3)
                if "asura" in text.lower():
                    self.hud_print("WAKE", "Asura awakened. Listening for command...")
                    self.is_active = True
                    # Let it roll into the next listen immediately
                else:
                    continue
            
            # 2. Get User Command
            text = await self.listen(timeout=5, phrase_limit=8)
            
            if not text:
                self.is_active = False
                continue
            
            if "go to sleep" in text.lower():
                self.hud_print("CORE", "Dormancy protocol engaged.")
                await self.speak("Understood, Sir. Entering standby.")
                self.is_active = False
                continue

            if any(cmd in text.lower() for cmd in ["deactivate", "shut down"]):
                self.hud_print("CORE", "System termination sequence initiated.")
                await self.speak("Asura system shutting down. Farewell, Sir.")
                os._exit(0)

            # Direct Vision/Capture checks
            if "vision" in text.lower():
                self.hud_print("SYSTEM", "Direct Vision Activation Protocol engaged.", Fore.GREEN)
                await self.execute_action("[[VISION: HANDS]]")
                self.is_active = True
                continue

            if any(cmd in text.lower() for cmd in ["capture screen", "screen capture"]):
                self.hud_print("SYSTEM", "Direct Screen Capture Protocol engaged.", Fore.GREEN)
                await self.capture_screen()
                self.is_active = True
                continue
            
            # 3. Process with AI
            self.hud_print("SENSORS", "Capturing visual data...")
            self.mic_status = "PROCESSING"
            screen_data = await self.capture_screen()
            
            current_query = text
            max_cycles = 5
            cycle_count = 0
            
            while cycle_count < max_cycles:
                cycle_count += 1
                try:
                    ai_response = await self.query_llm(current_query, screen_data)
                    self.mic_status = "READY"
                except Exception:
                    ai_response = "I encountered a neural synchronization error."
                    break
                
                monologue_match = re.search(r"<INTERNAL_MONOLOGUE>(.*?)(?:</INTERNAL_MONOLOGUE>|$)", ai_response, re.IGNORECASE | re.DOTALL)
                if monologue_match:
                    self.hud_print("THOUGHT", monologue_match.group(1).strip(), Fore.GREEN)
                
                actions = re.findall(r"\[\[.*?\]\]", ai_response, re.DOTALL)
                action_results = []
                for action in actions:
                    result = await self.execute_action(action)
                    if result:
                        self.hud_print("ACTION", f"{action} -> {result}", Fore.CYAN)
                        action_results.append(result)

                clean_text = re.sub(r"<INTERNAL_MONOLOGUE>.*?(?:</INTERNAL_MONOLOGUE>|$)", "", ai_response, flags=re.IGNORECASE | re.DOTALL)
                clean_text = re.sub(r"\[\[.*?\]\]", "", clean_text, flags=re.DOTALL)
                
                if clean_text.strip():
                    await self.speak(clean_text)
                
                if action_results:
                    context_update = "\n\n[SYSTEM: Action Results]\n" + "\n".join(action_results)
                    current_query = f"Previous results: {context_update}\n\nContinue with the next step of the task if there is one."
                    self.hud_print("CORE", f"Cycle {cycle_count} processed.")
                else:
                    break

