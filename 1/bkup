    def _draw_arc_ring(self, x, y, r, color, thickness, angle):
        """Advanced helper to draw rotating segmented arcs (True HUD)."""
        # Drawing 4 arcs to create a segmented ring look
        for i in range(4):
            start_ang = (angle + i * 90) % 360
            self.canvas.create_arc(x-r, y-r, x+r, y+r, outline=color, width=thickness, style="arc", start=start_ang, extent=60, tags="rings")

    def _draw_fractal_bolt(self, x1, y1, x2, y2, depth, displacement, color):
        """Recursive fractal lightning generator."""
        if depth <= 0:
            # End of recursion, draw the line
            self.canvas.create_line(x1, y1, x2, y2, fill=color, width=1, capstyle="round", tags="lightning")
            # Occasional micro-branch
            if random.random() > 0.8:
                bx = x2 + random.randint(-20, 20)
                by = y2 + random.randint(-20, 20)
                self.canvas.create_line(x2, y2, bx, by, fill=color, width=1, tags="lightning")
        else:
            mid_x = (x1 + x2) / 2
            mid_y = (y1 + y2) / 2
            mid_x += (random.random() - 0.5) * displacement
            mid_y += (random.random() - 0.5) * displacement
            self._draw_fractal_bolt(x1, y1, mid_x, mid_y, depth - 1, displacement / 2, color)
            self._draw_fractal_bolt(mid_x, mid_y, x2, y2, depth - 1, displacement / 2, color)

class AsuraAssistant:
